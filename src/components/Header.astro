---
import Menu from '../assets/icons/menu.svg';
---

<header class="border-b border-slate-800 bg-slate-900/95 text-slate-100 shadow-lg shadow-slate-950/20 backdrop-blur-sm transition-colors duration-300">
  <div class="container mx-auto flex items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-4">
      <div class="relative group">
        <button
          id="menu-toggle"
          type="button"
          data-testid="menu-toggle"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="site-menu"
          class="mr-4 rounded-lg border border-slate-700 bg-slate-800 p-2 text-slate-100 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
        >
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>

        <nav
          id="menu"
          aria-label="Main navigation"
          data-testid="site-menu"
          class="absolute left-0 top-full z-10 mt-2 hidden w-48 rounded-xl border border-slate-700 bg-slate-800 shadow-xl shadow-slate-950/40"
        >
          <ul class="py-2">
            <li>
              <a href="/" data-testid="nav-home-link" class="block px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                Home
              </a>
            </li>
            <li>
              <a href="/about" data-testid="nav-about-link" class="block px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                About
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <div class="text-xl font-bold tracking-tight">
        <a href="/" data-testid="brand-link" class="text-slate-100 transition-colors hover:text-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900">
          Tailspin Toys
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');

  if (menuToggle && menu) {
    const setMenuState = (isOpen: boolean): void => {
      menu.classList.toggle('hidden', !isOpen);
      menuToggle.setAttribute('aria-expanded', String(isOpen));
    };

    const toggleMenu = (): void => {
      const shouldOpen = menu.classList.contains('hidden');
      setMenuState(shouldOpen);

      if (shouldOpen) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    };

    menuToggle.addEventListener('click', toggleMenu);
    menuToggle.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleMenu();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));

      if (!isClickInside && !menu.classList.contains('hidden')) {
        setMenuState(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        setMenuState(false);
        menuToggle.focus();
      }
    });
  }
</script>